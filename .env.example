# NeuronAgent local / Docker Compose
# Copy: cp .env.example .env
# For production, set strong secrets and CONFIG_PROFILE=production (stricter validation).

# --- NeuronDB: build Postgres from a local clone (with `make up-neurondb` or docker compose merge file) ---
# Path to the NeuronDB repository root (contains docker/neurondb/Dockerfile). Sibling default:
# NEURONDB_REPO=../neurondb
# NEURONDB_IMAGE=neuronagent-neurondb:local
# PG_MAJOR=17
# Optional: NEURONDB_LLM_API_KEY=  (embeddings; leave empty for dev)

# --- Database (must match docker-compose postgres service) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=neurondb
DB_USER=neurondb
DB_PASSWORD=neurondb

# Port published on host for Postgres (docker-compose only)
POSTGRES_HOST_PORT=5433

# --- HTTP server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_HOST_PORT=8080

# development | staging | production — production refuses default DB passwords
CONFIG_PROFILE=development
# Optional alias for profile
# ENV=development

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- CORS (comma-separated) ---
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Workflow cron schedules (poll DB for due workflow_schedules) ---
# WORKFLOW_SCHEDULE_ENABLED=true
# WORKFLOW_SCHEDULE_INTERVAL=30s
# WORKFLOW_MAX_DURATION=0

# --- LLM sidecar for NeuronSQL HTTP routes (optional) ---
# LLM_SQL_BASE_URL=http://localhost:8000
# LLM_SQL_API_KEY=

# --- Demo / smoke tests: create a key with scripts/neuronagent-generate-keys.sh or cmd/generate-key ---
# NEURON_AGENT_API_KEY=your-key-here
